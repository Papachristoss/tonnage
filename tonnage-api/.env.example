# Copy this file to a local-only source of these env vars (e.g. export them in your
# shell profile, or use a .env loader / your IDE's run configuration).
# NEVER commit the real values - .env and application-local.properties are gitignored.

DB_URL=jdbc:postgresql://<your-neon-host>/<your-db>?sslmode=require
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>
JWT_SECRET=<a-new-random-secret-you-generate>
